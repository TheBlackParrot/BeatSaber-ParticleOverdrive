<settings-container xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
  <horizontal pref-width='90'>
    <text text='Particle Overdrive Settings' font-size='5' align='Center'/>
  </horizontal>
  
  <!--World Particles-->
  <settings-submenu text='→ World Particles...'>
    <settings-container>
      <clickable-text text='⮌ Back' align='Left' click-event='back' />
      
      <bool-setting text='Camera Noise' value='CameraGrain' apply-on-change='true'/>
      <bool-setting text='Dust Particles (Menu)' value='DustParticlesMenu' apply-on-change='true'/>
      <bool-setting text='Dust Particles (In-Game)' value='DustParticlesGame' apply-on-change='true'/>
    </settings-container>
  </settings-submenu>
  
  <!--Note Cut Particles-->
  <settings-submenu text='→ Note Cut Particles...'>
    <settings-container>
      <clickable-text text='⮌ Back' align='Left' click-event='back' />
      
      <list-setting text='Slash Particles' value='SlashParticleMultiplier' choices='ParticleMultiplierChoicesList' formatter='MultiplierDisplay' apply-on-change='true'/>
      <list-setting text='Slash Particle Lifetime' value='SlashParticleLifetimeMultiplier' choices='LifetimeValues' formatter='MultiplierDisplay' apply-on-change='true'/>
      <list-setting text='Slash Particle Size' value='SlashParticleSizeMultiplier' choices='LifetimeValues' formatter='MultiplierDisplay' apply-on-change='true'/>
      <list-setting text='Explosion Particles' value='ExplosionParticleMultiplier' choices='ParticleMultiplierChoicesList' formatter='MultiplierDisplay' apply-on-change='true'/>
      <list-setting text='Explosion Particle Lifetime' value='ExplosionParticleLifetimeMultiplier' choices='LifetimeValues' formatter='MultiplierDisplay' apply-on-change='true'/>
      <list-setting text='Explosion Particle Size' value='ExplosionParticleSizeMultiplier' choices='LifetimeValues' formatter='MultiplierDisplay' apply-on-change='true'/>
      <bool-setting text='Core Particles' value='NoteCoreParticles' apply-on-change='true'/>
      <bool-setting text='Rainbow Particles' value='RainbowParticles' apply-on-change='true'/>
    </settings-container>
  </settings-submenu>
  
  <!--Saber Clash Particles-->
  <settings-submenu text='→ Saber Clash Particles...'>
    <settings-container>
      <clickable-text text='⮌ Back' align='Left' click-event='back' />
      
      <list-setting text='Clash Particles' value='ClashParticleMultiplier' choices='ParticleMultiplierChoicesList' formatter='MultiplierDisplay' apply-on-change='true'/>
      <list-setting text='Clash Particles Lifetime' value='ClashParticleLifetimeMultiplier' choices='LifetimeValues' formatter='MultiplierDisplay' apply-on-change='true'/>
      <list-setting text='Clash Particles Size' value='ClashParticleSizeMultiplier' choices='LifetimeValues' formatter='MultiplierDisplay' apply-on-change='true'/>
      <bool-setting text='Clash Glow' value='ClashGlow' apply-on-change='true'/>
    </settings-container>
  </settings-submenu>
  
  <!-- Obstacle Saber Particles-->
  <settings-submenu text='→ Saber Wall Particles...'>
    <settings-container>
      <clickable-text text='⮌ Back' align='Left' click-event='back' />
      
      <list-setting text='Wall Particles' value='ObstacleParticleMultiplier' choices='ParticleMultiplierChoicesList' formatter='MultiplierDisplay' apply-on-change='true'/>
      <list-setting text='Wall Particles Lifetime' value='ObstacleParticleLifetimeMultiplier' choices='LifetimeValues' formatter='MultiplierDisplay' apply-on-change='true'/>
      <list-setting text='Wall Particles Size' value='ObstacleParticleSizeMultiplier' choices='LifetimeValues' formatter='MultiplierDisplay' apply-on-change='true'/>
    </settings-container>
  </settings-submenu>
  
</settings-container>